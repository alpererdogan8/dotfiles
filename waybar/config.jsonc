{
  "layer": "top",
  "position": "top",
  "height": 1,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["custom/clock"],
  "modules-right": [
    "network",
    "custom/power",
    // "custom/bluetooth",
    "cpu",
    "memory",
    "custom/temperature",
    "battery",
    "custom/swaync-open-button",
  ],
  // "custom/bluetooth": {
  //   "exec": "$HOME/.config/rofi/bt-status.sh",
  //   "return-type": "json",
  //   "interval": 10,
  //   "signal": 9,
  //   "on-click": "bash $HOME/.config/rofi/toggle_bluetooth.sh",
  //   "tooltip": true,
  // },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "warp-on-scroll": false,
    "format": "{id}",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_raw(\"workspace {id}\")'",
    "ignore-window-groups": true,
    "persistent-workspaces": {
      "*": 0,
    },
  },
  "custom/clock": {
    "exec": "sh -c '$HOME/.config/waybar/scripts/clock_focus.sh'",
    "return-type": "json",
    "tooltip": true,
  },
  "network": {
    "tooltip": true,
    "format": "{icon}",
    "format-ethernet": "󰈀",
    "format-wifi": "{icon} {ipaddr}",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid}  ·  {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}  ·  {ipaddr}",
    "tooltip-format-disconnected": "Bağlantı yok",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
  },
  "custom/power": {
    "format": "{}",
    "exec": "sleep 3 && sh -c '$HOME/.local/bin/auto-cpufreq.sh'",
    "on-click": "sh -c '$HOME/.local/bin/auto-cpufreq.sh open'",
    "return-type": "json",
    "signal": 8,
    "interval": "once",
    "tooltip": true,
  },
  "cpu": {
    "format": "󰍛 {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU  {usage}%\nKullanıcı {user}%  ·  Sistem {system}%",
  },
  "memory": {
    "format": "󰘚 {percentage}%",
    "tooltip": true,
    "tooltip-format": "RAM  {used:0.1f} / {total:0.1f} GiB",
  },
  "custom/temperature": {
    "exec": "sh -c '$HOME/.config/waybar/scripts/avg_temp.sh'",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "tooltip-format": "{timeTo}\n{power:.1f} W",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true,
  },
  "custom/swaync-open-button": {
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#ff6b6b'>󰂚</span>",
      "none": "󰂚",
      "dnd-notification": "<span foreground='#ff6b6b'>󰂛</span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "<span foreground='#ff6b6b'>󰂚</span>",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "<span foreground='#ff6b6b'>󰂛</span>",
      "dnd-inhibited-none": "󰂛",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "tooltip": true,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
}
