# The defaults below could be overridden in $XDG_CONFIG_HOME/swaylock/config
#  (~/.config/swaylock/config).
#
# Image path supports environment variables and shell expansions,
# e.g. image=$HOME/Pictures/default.png
image=$HOME/Pictures/wallpapers/abstract_a_map_of_a_city.jpg
scaling=fill
ignore-empty-password
show-failed-attempts
indicator-radius=100
indicator-thickness=8
inside-color=00000000
inside-clear-color=00000000
inside-ver-color=00000000
inside-wrong-color=00000000
ring-color=00000080
ring-clear-color=00000080
ring-ver-color=000000ff
ring-wrong-color=800000ff
text-color=000000ff
text-clear-color=000000ff
text-ver-color=000000ff
text-wrong-color=000000ff
key-hl-color=000000ff
line-color=00000000
separator-color=00000000
