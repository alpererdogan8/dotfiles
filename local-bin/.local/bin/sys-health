#!/usr/bin/env bash
# =============================================================================
# sys-health — System diagnostic snapshot
#
# Prints a quick overview of: network (DNS + connectivity), active services,
# disk usage, memory, and CPU load — all in one pass.
# =============================================================================

set -euo pipefail

# ── Colors ────────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

header() { printf "\n${BOLD}${CYAN}── %s ${RESET}\n" "$1"; }
ok()     { printf "  ${GREEN}✓${RESET}  %s\n" "$1"; }
warn()   { printf "  ${YELLOW}⚠${RESET}  %s\n" "$1"; }
fail()   { printf "  ${RED}✗${RESET}  %s\n" "$1"; }

# ── Network ───────────────────────────────────────────────────────────────────
header "Network"

# DNS resolution check
if host -W 2 google.com &>/dev/null; then
    ok "DNS resolving (google.com)"
else
    fail "DNS not resolving"
fi

# Gateway reachability
gateway=$(ip route 2>/dev/null | awk '/^default/ {print $3; exit}')
if [[ -n "$gateway" ]]; then
    if ping -c 1 -W 2 "$gateway" &>/dev/null; then
        ok "Gateway reachable ($gateway)"
    else
        fail "Gateway unreachable ($gateway)"
    fi
else
    warn "No default gateway found"
fi

# Active interface & IP
ip_info=$(ip -4 -o addr show scope global 2>/dev/null | awk '{printf "%s  %s\n", $2, $4}')
if [[ -n "$ip_info" ]]; then
    while IFS= read -r line; do ok "$line"; done <<< "$ip_info"
else
    warn "No active IPv4 interfaces"
fi

# DNS servers in use
dns_servers=$(resolvectl status 2>/dev/null \
    | awk '/DNS Servers:/ {for(i=3;i<=NF;i++) printf $i" "; print ""}' \
    | xargs)
[[ -n "$dns_servers" ]] && ok "DNS servers: $dns_servers" || warn "Could not detect DNS servers"

# ── Disk ──────────────────────────────────────────────────────────────────────
header "Disk"
df -h --output=target,size,used,avail,pcent 2>/dev/null \
    | grep -E '^(/|/home|/boot|/tmp)' \
    | while IFS= read -r line; do
        usage=$(echo "$line" | awk '{print $5}' | tr -d '%')
        if   [[ "$usage" -ge 90 ]]; then fail "$line"
        elif [[ "$usage" -ge 75 ]]; then warn "$line"
        else                              ok   "$line"
        fi
    done

# ── Memory ────────────────────────────────────────────────────────────────────
header "Memory"
mem=$(free -h | awk '/^Mem:/ {printf "Used %s / %s (available: %s)", $3, $2, $7}')
swap=$(free -h | awk '/^Swap:/ {printf "Swap used %s / %s", $3, $2}')
ok "$mem"
ok "$swap"

# ── CPU ───────────────────────────────────────────────────────────────────────
header "CPU"
load=$(cat /proc/loadavg | awk '{print $1, $2, $3}')
cores=$(nproc)
ok "Load avg: $load  (${cores} cores)"

top_proc=$(ps -eo comm,pcpu --no-headers --sort=-pcpu | head -3 \
    | awk '{printf "%s %.1f%%  ", $1, $2}')
ok "Top procs: $top_proc"

# ── Failed systemd services ───────────────────────────────────────────────────
header "Systemd"
failed=$(systemctl --failed --no-legend --no-pager 2>/dev/null | wc -l)
if [[ "$failed" -eq 0 ]]; then
    ok "No failed services"
else
    fail "$failed failed service(s):"
    systemctl --failed --no-legend --no-pager 2>/dev/null \
        | awk '{print "     " $2}' \
        | while IFS= read -r line; do warn "$line"; done
fi

printf "\n"
