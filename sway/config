# Default config for sway
#
# Read `man 5 sway` for a complete reference.

### Variables
set $mod Mod4
set $term ghostty +new-window
# Raycast-inspired app launcher — uses launcher.rasi theme
set $menu rofi -show combi -config ~/.config/rofi/launcher.rasi
set $fileManager nautilus

### Output configuration
# Output enable/disable and resolution are managed by kanshi (~/.config/sway/kanshi).
# kanshi automatically switches to eDP-1 when HDMI-A-1 is unplugged.
# output * bg /usr/share/backgrounds/default-dark.jxl fill
#output * bg $HOME/Pictures/abstract_a_black_and_white_picture_of_mountains_and_trees.png fill

### Borders and gaps
# Single consistent border style everywhere — prevents layout shift on focus change
smart_borders off
hide_edge_borders none

default_border pixel 1
default_floating_border pixel 1

for_window [app_id="^.*"] border pixel 1
for_window [class="^.*"] border pixel 1

gaps inner 3
smart_gaps on

client.focused   #7c8b9a #7c8b9a #1e1e1e #7c8b9a #7c8b9a
client.unfocused #3a3a3a #3a3a3a #7c8b9a #3a3a3a #3a3a3a

### Autostart
# kanshi: dynamic output manager — handles monitor hotplug (HDMI <-> eDP-1)
exec_always kanshi -c ~/.config/sway/kanshi
exec uwsm app -- /usr/libexec/kdeconnectd
exec uwsm app -- kdeconnect-indicator
exec uwsm app -- swayosd-server
exec uwsm app -- awww-daemon
# exec uwsm app -- $HOME/.local/bin/autotiling-rs
exec_always uwsm app -- $HOME/.local/bin/autotiling-rs

# cliphist: clipboard history daemon — stores entries as clipboard changes
exec_always wl-paste --watch cliphist store

# gnome-keyring: --start forks and exits immediately, must not be wrapped
# with uwsm app --. pkcs11+secrets come from Fedora's systemd user socket
# service; this exec only adds the ssh component.
exec "gnome-keyring-daemon --start --components=pkcs11,secrets,ssh"

### Idle configuration
# Managed by /usr/share/sway/config.d/20-swayidle.conf
# To customize: create ~/.config/sway/config.d/20-swayidle.conf

### Input configuration
input "2:7:SynPS/2_Synaptics_TouchPad" {
    accel_profile "adaptive"
    dwt enabled
    tap enabled
    tap_button_map lrm
    natural_scroll enabled
    middle_emulation enabled
    pointer_accel 0.4
    scroll_method two_finger
    drag enabled
}



input * {
    xkb_layout "tr"
}

bindgesture swipe:3:right workspace prev
bindgesture swipe:3:left workspace next
bindgesture swipe:4:down kill


### Key bindings
#
# Basics:
#
    bindsym $mod+Return exec uwsm app -- $term

    bindsym $mod+w kill
    bindsym $mod+alt+w exec swaymsg -t get_tree | jq -r '.. | select(.focused? == true) | .pid' | xargs kill -9

    # rofi is a launcher, not a managed app — no uwsm app needed
    bindsym $mod+d exec $menu
    # display-mode: pick kanshi output profile via rofi (extend/extended/mirror/laptop)
    bindsym $mod+Shift+p exec ~/.local/bin/display-mode
    bindsym $mod+e exec uwsm app -- $fileManager
    bindsym $mod+r exec uwsm app -- vicinae toggle

    bindsym $mod+l exec loginctl lock-session
    # wallpa er script manages its own child processes
    bindsym $mod+shift+w exec $HOME/.local/bin/wallpaper_cycle.sh

    bindsym $mod+n exec swaync-client -R && swaync-client -rs && swaync-client -t -sw
    # bindsym alt+v exec uwsm app -- vicinae vicinae://launch/clipboard/history
    bindsym alt+v exec ~/.local/bin/clipboard-menu
    bindsym $mod+ctrl+s exec grim -g "$(slurp)" - | wl-copy -t image/png

    # bindsym alt+Tab exec uwsm app -- snappy-switcher next --mod alt
    # bindsym $mod+Tab exec uwsm app -- snappy-switcher next --workspace --mod super

    floating_modifier $mod normal

    bindsym $mod+Shift+c reload
    # swaynag is a short-lived dialog — no uwsm app needed
    bindsym $mod+Shift+m exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Arrow keys only; vim h/j/k/l intentionally disabled
    # ($mod+l = lock session, $mod+j = layout toggle)
    bindsym $mod+Left  focus left
    bindsym $mod+Down  focus down
    bindsym $mod+Up    focus up
    bindsym $mod+Right focus right

    bindsym $mod+Shift+Left  move left
    bindsym $mod+Shift+Down  move down
    bindsym $mod+Shift+Up    move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # 1–5 on external monitor, 6–10 on laptop display
    workspace 1 output HDMI-A-1
    workspace 2 output HDMI-A-1
    workspace 3 output HDMI-A-1
    workspace 4 output HDMI-A-1
    workspace 5 output HDMI-A-1
    workspace 6 output eDP-1
    workspace 7 output eDP-1
    workspace 8 output eDP-1
    workspace 9 output eDP-1
    workspace 10 output eDP-1

    # focus floating: when scratchpad is visible (sticky+floating), re-focus it
    # after workspace switch; when scratchpad is hidden, this is a silent no-op.
    bindsym $mod+1 workspace number 1; focus floating
    bindsym $mod+2 workspace number 2; focus floating
    bindsym $mod+3 workspace number 3; focus floating
    bindsym $mod+4 workspace number 4; focus floating
    bindsym $mod+5 workspace number 5; focus floating
    bindsym $mod+6 workspace number 6; focus floating
    bindsym $mod+7 workspace number 7; focus floating
    bindsym $mod+8 workspace number 8; focus floating
    bindsym $mod+9 workspace number 9; focus floating
    bindsym $mod+0 workspace number 10; focus floating

    bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10

    bindsym alt+Right workspace next_on_output; focus floating
    bindsym alt+Left  workspace prev_on_output; focus floating
    # Move container to next/prev *numbered* workspace (including empty ones) and follow.
    # Uses ~/.local/bin/sway-move-workspace to step ±1 regardless of active state.
    bindsym alt+shift+Right exec ~/.local/bin/sway-move-workspace next
    bindsym alt+shift+Left  exec ~/.local/bin/sway-move-workspace prev
#
# Layout:
#
    bindsym $mod+b splith
    bindsym $mod+v floating toggle

    bindsym $mod+j layout toggle split
    bindsym $mod+shift+j swap container with next

    bindsym $mod+f layout toggle tabbed splith
    bindsym $mod+shift+f fullscreen
    bindsym $mod+alt+p fullscreen toggle global

bindsym $mod+space focus mode_toggle
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    bindsym $mod+Shift+s move scratchpad
    bindsym $mod+s scratchpad show; [con_id="__focused__" floating] sticky enable; [con_id="__focused__" floating] resize set 98 ppt 96 ppt; [con_id="__focused__" floating] move position center
#
# Resize mode:
#
mode "resize" {
    bindsym Left  resize shrink width 10px
    bindsym Down  resize grow height 10px
    bindsym Up    resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+r mode "resize"

### Lid switch
bindswitch --locked lid:on  exec swaymsg output eDP-1 disable && swaylock -f
bindswitch --locked lid:off exec swaymsg output eDP-1 enable









### Advanced Sway features - test bindings

# Focus child container
# Original default: no default binding
bindsym $mod+Shift+a focus child


# Explicit vertical split
# Original default: $mod+v
# Your $mod+v is used for floating toggle
bindsym $mod+Shift+b splitv


# Stacking layout
# Original default: $mod+s
# Your $mod+s is used for scratchpad show
bindsym $mod+Ctrl+f layout stacking


# Go back to the previously focused workspace
# Original default: no default binding
bindsym $mod+grave workspace back_and_forth


# Focus another output / monitor
# Original default: no default binding
bindsym $mod+Ctrl+Left  focus output left
bindsym $mod+Ctrl+Right focus output right


# Move focused container to another output / monitor
# Original default: no default binding
bindsym $mod+Ctrl+Shift+Left  move container to output left
bindsym $mod+Ctrl+Shift+Right move container to output right


# Move entire current workspace to another output / monitor
# Original default: no default binding
bindsym $mod+Ctrl+Alt+Left  move workspace to output left
bindsym $mod+Ctrl+Alt+Right move workspace to output right


# Center focused floating window
# Original default: no default binding
bindsym $mod+Ctrl+c move position center


# Toggle gaps on current workspace
# Original default: no default binding
bindsym $mod+g gaps inner current toggle 0

















### Fedora Sway layered config.d
# Files in ~/.config/sway/config.d/ override same-named files in
# /etc/sway/config.d/ and /usr/share/sway/config.d/.
# Example — disable the default bar:
#   echo -n > ~/.config/sway/config.d/90-bar.conf
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
