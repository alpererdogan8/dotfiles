#!/usr/bin/env bash
# sway-swap-workspaces — swap what the two active outputs are showing.
#
# The workspaces keep their names and their outputs: ws 1-5 stay on the external
# monitor, ws 6-10 on the laptop panel, exactly as `workspace <n> output <o>` and
# kanshi assign them. Only the *contents* of the two visible workspaces change
# screens.
#
# ---------------------------------------------------------------------------
# Why this does not touch a single window
#
# Moving windows one by one (`move container to workspace`) makes the result
# depend on the layout tree: sway resolves the destination to the destination's
# focus-inactive container, and a container that carries children is *unwrapped*
# when it lands in an empty workspace (its id disappears, its children become
# separate top-level windows). Splits, orientation and window count all change
# what happens, and anything the script was not tracking by id is left behind.
#
# A workspace node is the one unit that already holds its whole subtree (splits,
# tabbed/stacked layouts, sizes, floating and fullscreen windows, urgency, marks).
# So the swap is done on the workspace nodes themselves:
#
#   1. swap the two *names* (A <-> B) with `rename workspace`, through a temporary
#      name, because names must be unique;
#   2. move each renamed workspace to the output its new name belongs to with
#      `move workspace to output`.
#
# After that every output shows the other output's tree under its own, unchanged
# workspace name. The hidden workspaces of both outputs are never involved.
# ---------------------------------------------------------------------------
set -euo pipefail

dry_run=false
if [[ ${1:-} == "--dry-run" ]]; then
    dry_run=true
fi

die() { echo "sway-swap-workspaces: $*" >&2; exit 1; }

outputs=$(swaymsg -t get_outputs -r)

# Only enabled outputs that actually show a workspace take part.
mapfile -t active < <(
    jq -r '.[] | select(.active and .current_workspace != null) | .name' <<<"$outputs"
)
(( ${#active[@]} == 2 )) || die "expected 2 active outputs, found ${#active[@]}"

focused=$(jq -r '.[] | select(.active and .current_workspace != null and .focused) | .name' <<<"$outputs")
[[ -n $focused ]] || die "no focused output"
other=${active[0]}
[[ $other == "$focused" ]] && other=${active[1]}

# Only the workspace each output currently shows.
ws_focused=$(jq -r --arg out "$focused" '.[] | select(.name == $out) | .current_workspace' <<<"$outputs")
ws_other=$(jq -r --arg out "$other" '.[] | select(.name == $out) | .current_workspace' <<<"$outputs")

# Names end up inside sway command strings. Output names are DRM connector names;
# workspace names may carry spaces, colons or icon glyphs, so they are quoted and
# only characters that can break out of a quoted sway argument are refused.
for out in "$focused" "$other"; do
    [[ $out =~ ^[A-Za-z0-9._-]+$ ]] || die "unsupported output name '$out'"
done
for ws in "$ws_focused" "$ws_other"; do
    case $ws in
        *[\"\\\;,\$]* | *$'\n'* | "") die "unsupported workspace name '$ws'" ;;
    esac
done

# Fixed temp name (no PID) so waybar can target it: format-icons "__swap": ""
# renders an empty label and style.css collapses the button.
tmp="__swap"

# Run sway commands and fail loudly if sway reports any of them as failed.
sway_cmd() {
    local reply
    reply=$(swaymsg -r "$1") || die "swaymsg failed: $1"
    if jq -e 'any(.[]; .success == false)' >/dev/null <<<"$reply"; then
        die "sway rejected: $1 ($(jq -r '[.[] | select(.success == false) | .error] | join("; ")' <<<"$reply"))"
    fi
}

# Output a workspace currently lives on ("" when it does not exist).
output_of() {
    swaymsg -t get_workspaces -r | jq -r --arg w "$1" '[.[] | select(.name == $w) | .output][0] // ""'
}

# Bring workspace $1 to output $2 unless it is already there. Idempotent, so it
# also finishes the job if an earlier step was interrupted.
ensure_on() {
    [[ $(output_of "$1") == "$2" ]] && return 0
    sway_cmd "workspace --no-auto-back-and-forth \"$1\""
    sway_cmd "move workspace to output $2"
}

if $dry_run; then
    printf '# %s/%s  <->  %s/%s\n' "$focused" "$ws_focused" "$other" "$ws_other"
    printf '# 1) swap the two names through a temporary one\n'
    printf 'rename workspace "%s" to "%s"\n' "$ws_focused" "$tmp"
    printf 'rename workspace "%s" to "%s"\n' "$ws_other" "$ws_focused"
    printf 'rename workspace "%s" to "%s"\n' "$tmp" "$ws_other"
    printf '# 2) send each renamed workspace to the output its name belongs to\n'
    printf 'workspace --no-auto-back-and-forth "%s"\nmove workspace to output %s\n' "$ws_other" "$other"
    printf 'workspace --no-auto-back-and-forth "%s"\nmove workspace to output %s\n' "$ws_focused" "$focused"
    printf '# 3) leave focus where the key was pressed\n'
    printf 'focus output %s\n' "$focused"
    exit 0
fi

# 1) Swap the names. One swaymsg call, so nothing can happen in between.
# A leftover __swap from an interrupted run would collide with the temp name.
[[ -z $(output_of "$tmp") ]] || die "stale '$tmp' workspace exists from an interrupted swap, inspect it first"
sway_cmd "rename workspace \"$ws_focused\" to \"$tmp\"; rename workspace \"$ws_other\" to \"$ws_focused\"; rename workspace \"$tmp\" to \"$ws_other\""

# The tree that was on $focused is now called $ws_other, and the tree that was on
# $other is now called $ws_focused. Each name goes back to its own output.
ensure_on "$ws_other" "$other"
ensure_on "$ws_focused" "$focused"

# Focus goes back to the output the key was pressed on.
sway_cmd "focus output $focused"

# Final check: each output must show the workspace it showed before, by name.
now_f=$(swaymsg -t get_outputs -r | jq -r --arg o "$focused" '.[] | select(.name == $o) | .current_workspace')
now_o=$(swaymsg -t get_outputs -r | jq -r --arg o "$other" '.[] | select(.name == $o) | .current_workspace')
if [[ $now_f != "$ws_focused" || $now_o != "$ws_other" ]]; then
    die "unexpected result: $focused shows '$now_f', $other shows '$now_o'"
fi
