# kanshi output profile configuration
#
# --- Automatic hotplug profiles ---
# Kanshi matches profiles by which outputs are physically connected.
# These two profiles switch automatically on cable plug/unplug.
#
# --- Manual profiles ---
# "extend", "extended", "mirror" and "laptop" all require HDMI to be connected
# for manual switching. Because they share the same connected-output set,
# kanshi cannot pick between them automatically. Switch manually with:
#   kanshictl switch <profile-name>
# or use Super+Shift+P to open the display-mode rofi picker.
#
# `kanshi` itself is a daemon: starting it a second time (e.g. `kanshi reload`)
# unlinks and rebinds its IPC socket, orphaning the systemd service and
# breaking every later `kanshictl` call. Reload with `kanshictl reload` (or
# `systemctl --user reload kanshi`); the Super+Shift+C binding does that.

# Subpixel ordering is not expressible as an `output` directive, so it is set
# with `exec`. These call swaymsg directly: kanshi runs as a systemd user
# service and inherits SWAYSOCK, so no socket discovery is needed. Wrapping
# them in `sh -c 'SWAYSOCK=$(ls /run/user/UID/sway-ipc.* | head -1) ...'`
# fails, because kanshi splits the command on whitespace and the shell then
# tries to run "head -1" as a program.

# Both screens: HDMI as primary (top), laptop as secondary (bottom) (default)
profile extended {
    output HDMI-A-1 enable mode 1920x1080@120Hz position 0,0 scale 1
    exec swaymsg output HDMI-A-1 subpixel rgb
    # output eDP-1 enable position 1920,120
    # output eDP-1 enable position 400,1080
    output eDP-1 enable mode 1366x768 position -1366,450 scale 1
    exec swaymsg output eDP-1 subpixel rgb
}

# HDMI only: external monitor only, laptop screen off
profile extend {
    output HDMI-A-1 enable mode 1920x1080@120Hz position 0,0
    exec swaymsg output HDMI-A-1 subpixel rgb
    # eDP-1 gets no subpixel line: it is disabled in this profile, so there is
    # nothing on screen to set it for.
    output eDP-1 disable
}

# Mirror: both outputs at position 0,0 — wlroots scales the difference.
# HDMI uses its native mode; eDP-1 follows its own native resolution.
profile mirror {
    output HDMI-A-1 enable mode 1920x1080@120Hz position 0,0
    exec swaymsg output HDMI-A-1 subpixel rgb
    output eDP-1 enable position 0,0
    exec swaymsg output eDP-1 subpixel rgb
}

# Laptop only (manual override while HDMI is still physically connected).
# Explicitly disables HDMI so kanshi accepts the profile switch.
profile laptop {
    output HDMI-A-1 disable
    output eDP-1 enable
    exec swaymsg output eDP-1 subpixel rgb
}
