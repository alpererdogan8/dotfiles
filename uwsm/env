export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
# export DOCKER_HOST="unix://$XDG_RUNTIME_DIR/podman/podman.sock"

# Single source of truth for TERMINAL. uwsm's env-preloader injects this file
# into the systemd user manager, so it reaches every shell and GUI app in the
# session. Consumers: waybar's on-click commands (`$TERMINAL --title=...`).
# Do NOT re-declare it in zsh/zsh/configs/env.zsh — that would be a second
# place to forget when switching terminal emulators.
export TERMINAL=ghostty

#export QT_QPA_PLATFORMTHEME=qt6ct
#export QT_QPA_PLATFORMTHEME=kde
export QT_QPA_PLATFORMTHEME=gtk3
export ELECTRON_FLAGS="--password-store=gnome-libsecret"

#export XDG_MENU_PREFIX="plasma-"


#export GDK_BACKEND="wayland,x11,*"
export LIBVA_DRIVER_NAME=iHD
export GBM_BACKEND=drm-intel
export __GLX_VENDOR_LIBRARY_NAME=mesa

export XCURSOR_THEME=Nordic-cursors
export XCURSOR_SIZE=24

export CLUTTER_DEFAULT_FPS=120
export __GL_MAX_FRAMES_BETWEEN_PRESENT=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland


export CARGO_TARGET_DIR="/tmp/cargo-target"
