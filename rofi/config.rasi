/**
 * Rofi — Global Configuration
 * Design language: minimal dark, southeast anchor, Inter 11.
 * Tokens are untouched from the original; only structure and comments added.
 */

/* ─── Behavior ───────────────────────────────────────────── */
configuration {
    steal-focus:     true;
    show-icons:      false;
    font:            "Inter 11";
    hover-select:    true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    kb-cancel: "Escape";
    click-to-exit: true;
}

/* ─── Design tokens ──────────────────────────────────────── */
* {
    bg:           #000000;
    bg-alt:       #11111b;
    fg:           #ffffff;
    accent:       #d1d1d1ff;
    border-color: rgba(255, 255, 255, 0.118);

    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

/* ─── Window — southeast anchor ─────────────────────────── */
window {
    width:            400px;
    location:         southeast;
    anchor:           southeast;
    x-offset:         -10px;
    y-offset:         -98px;
    background-color: @bg;
    border:           1px;
    border-color:     @border-color;
    border-radius:    0;
    cursor:           "default";
}

/* ─── Layout ─────────────────────────────────────────────── */
mainbox {
    children:         [ "inputbar", "listview" ];
    background-color: @bg;
    padding:          8px;
    spacing:          8px;
}

/* ─── Input ──────────────────────────────────────────────── */
inputbar {
    enabled:          false;
    background-color: @bg-alt;
    padding:          8px;
    border-radius:    4px;
    children:         [ "prompt", "entry" ];
    spacing:          8px;
}

prompt {
    text-color:     @accent;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search...";
    placeholder-color: rgba(255, 255, 255, 0.3);
    text-color:        @fg;
    vertical-align:    0.5;
}

/* ─── List ───────────────────────────────────────────────── */
listview {
    columns:      1;
    lines:        5;
    cycle:        true;
    dynamic:      true;
    fixed-height: false;
    scrollbar:    false;
    spacing:      4px;
}

/* ─── Items ──────────────────────────────────────────────── */
element {
    padding:       10px;
    border-radius: 4px;
    children:      [ element-text ];
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
    border-radius:    4px;
}

element-text {
    vertical-align:   0.5;
    horizontal-align: 0.0;
    text-color:       inherit;
}