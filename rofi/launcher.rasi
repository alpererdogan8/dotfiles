/**
 * Rofi Launcher — KRunner / Raycast-inspired universal launcher
 * Default mode: combi (global search across all categories)  |  Keybind: Super+D
 *
 * Features (pure rofi, no external scripts):
 *   • Global    — combi  — searches drun + window + run + filebrowser simultaneously
 *                          each result shows its source category as a dim prefix
 *   • Apps      — drun    — installed application search with icons
 *   • Windows   — window  — open window switcher
 *   • Commands  — run     — PATH binary runner
 *   • Files     — filebrowser — file system navigation
 *   • Mode bar  — visual tab bar; combi tab is always selected on launch
 *   • Message bar — context-sensitive hint line at the bottom
 *
 * Launch:         rofi -show combi -theme ~/dotfiles/rofi/launcher.rasi
 * Navigate modes: Shift+Right / Shift+Left  or  Ctrl+Tab / Ctrl+Shift+Tab
 * Same color tokens as config.rasi — only layout differs.
 */

/* ─── Mode configuration ────────────────────────────────── */
configuration {
    /*
     * combi is listed first so "-show combi" lands on the Global tab.
     * The remaining modes are still reachable via the tab bar.
     */
    modes:              "combi,drun,window,run,filebrowser";

    /* combi searches all four sub-modes simultaneously */
    combi-modes:        "drun,window,run,filebrowser";

    /*
     * Show a dim category prefix on every combi result so the user
     * always knows which mode a result comes from — KRunner-style.
     * Format: "<mode-label>  <entry-text>"
     */
    combi-hide-mode-prefix: false;
    combi-display-format:   "{mode}  {text}";

    /* Show icons for apps and windows */
    show-icons:         true;
    icon-theme:         "Papirus";

    /* drun: plain app name only (category shown via combi prefix) */
    drun-display-format: "{name}";

    /* Mode-switcher display labels (Nerd Font icons + label) */
    display-combi:       "󰍉 Global";
    display-drun:        " Apps";
    display-window:      " Windows";
    display-run:         " Run";
    display-filebrowser: " Files";

    /* Cycle through modes */
    kb-mode-next:        "Shift+Right,Control+Tab";
    kb-mode-previous:    "Shift+Left,Control+ISO_Left_Tab";

    /* Cache desktop entries for faster startup */
    drun-use-desktop-cache: true;
    /* Mouse support */
    hover-select:    true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    kb-cancel: "Escape";
    click-to-exit: true;
}

/* ─── Design tokens (same palette as config.rasi) ───────── */
* {
    bg:              #000000;
    bg-alt:          #11111b;
    bg-mode:         #0d0d0d;
    fg:              #ffffff;
    fg-dim:          rgba(255, 255, 255, 0.45);
    accent:          #d1d1d1ff;
    accent-dim:      rgba(209, 209, 209, 0.12);
    border-col:      rgba(255, 255, 255, 0.118);
    blue:            #3c6eb4;

    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

/* ─── Window — centered spotlight ───────────────────────── */
window {
    width:            640px;
    location:         center;
    anchor:           center;
    background-color: @bg;
    border:           1px;
    border-color:     @border-col;
    border-radius:    10px;
    cursor:           "default";
}

/* ─── Root layout ─────────────────────────────────────────── */
mainbox {
    children:         [ "inputbar", "mode-switcher", "listview", "message" ];
    background-color: @bg;
    padding:          0px;
    spacing:          0px;
    border-radius:    10px;
}

/* ─── Search bar ─────────────────────────────────────────── */
inputbar {
    enabled:          true;
    background-color: @bg;
    padding:          14px 16px;
    border-radius:    10px 10px 0px 0px;
    children:         [ "prompt", "entry" ];
    spacing:          10px;
    border:           0px 0px 1px 0px;
    border-color:     @border-col;
}

prompt {
    /* Nerd Font icon changes per mode via display-* labels defined above */
    text-color:     @blue;
    vertical-align: 0.5;
    font:           "JetBrainsMono Nerd Font 13";
}

entry {
    placeholder:       "Search apps, windows, commands, files…";
    placeholder-color: @fg-dim;
    text-color:        @fg;
    vertical-align:    0.5;
    font:              "Inter 12";
    cursor-color:      @accent;
}

/* ─── Mode-switcher tab bar ──────────────────────────────── */
/*
 * Renders as a pill-row below the search bar, one button per mode.
 * Active mode button gets the accent background so the user always
 * knows which scope is currently active — just like KRunner's tabs.
 */
mode-switcher {
    enabled:          true;
    background-color: @bg-mode;
    padding:          6px 12px;
    spacing:          4px;
    border:           0px 0px 1px 0px;
    border-color:     @border-col;
    orientation:      horizontal;
    expand:           false;
}

button {
    background-color: transparent;
    text-color:       @fg-dim;
    padding:          4px 10px;
    border-radius:    4px;
    font:             "Inter 10";
    cursor:           pointer;
}

button selected {
    background-color: @accent-dim;
    text-color:       @fg;
    border:           1px;
    border-color:     @border-col;
}

/* ─── Results list ───────────────────────────────────────── */
listview {
    columns:      1;
    lines:        8;
    cycle:        false;
    dynamic:      true;
    fixed-height: false;
    scrollbar:    false;
    spacing:      2px;
    padding:      8px;
}

/* ─── Result items ───────────────────────────────────────── */
element {
    padding:      9px 12px;
    border-radius: 6px;
    children:     [ element-icon, element-text ];
    spacing:      12px;
    orientation:  horizontal;
    cursor:       pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: transparent;
    text-color:       #f38ba8;
}

element normal.active {
    background-color: transparent;
    text-color:       @blue;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element alternate.urgent {
    background-color: transparent;
    text-color:       #f38ba8;
}

element alternate.active {
    background-color: transparent;
    text-color:       @blue;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
    border-radius:    6px;
}

element selected.urgent {
    background-color: #f38ba8;
    text-color:       @bg;
    border-radius:    6px;
}

element selected.active {
    background-color: @blue;
    text-color:       @fg;
    border-radius:    6px;
}

element-icon {
    size:             22px;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    horizontal-align: 0.0;
    text-color:       inherit;
    font:             "Inter 11";
}

/* ─── Message / hint bar ─────────────────────────────────── */
/*
 * Rofi shows the -mesg string here when passed on the CLI.
 * It also appears automatically in filebrowser mode with path info.
 * This gives the Raycast-style "context footer" look.
 */
message {
    enabled:          true;
    background-color: @bg-mode;
    padding:          6px 16px;
    border-radius:    0px 0px 10px 10px;
    border:           1px 0px 0px 0px;
    border-color:     @border-col;
}

textbox {
    text-color:       @fg-dim;
    font:             "Inter 10";
    vertical-align:   0.5;
    horizontal-align: 0.0;
    background-color: transparent;
}
