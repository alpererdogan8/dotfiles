{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "~/Pictures/Profile/iris_crop.jpeg",
    "height": 16,
    "padding": {
      "top": 0,
      "right": 2,
    },
  },
  "display": {
    "separator": "  ",
    "constants": ["────────────────"],
    "key": {
      "type": "icon",
      "paddingLeft": 3,
    },
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌{$1} Hardware Information {$1}┐",
    },
    "host",
    {
      "type": "cpu",
      "format": "{name}",
    },
    {
      "type": "gpu",
      "format": "{vendor} {name}",
    },
    "memory",
    "swap",
    "disk",
    "display",
    "break",
    {
      "type": "custom",
      "format": "├{$1} System Information {$1}──┤",
    },
    "break",
    "os",
    "kernel",
    "uptime",
    // "localip",
    "break",
    {
      "type": "custom",
      "format": "├{$1} Software Information {$1}┤",
    },
    "break",
    "wm",
    "shell",
    "terminal",
    "font",
    "packages",
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────┘",
    },
    "colors",
  ],
}
