{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/dotfiles/fastfetch/berserk-logo.txt",
    "color": {
      "1": "red"
    },
    "padding": {
      "top": 0,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "constants": ["────────────────"],
    "key": {
      "type": "icon",
      "paddingLeft": 3,
    },
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌{$1} Hardware Information {$1}┐",
    },
    "host",
    {
      "type": "cpu",
      "format": "{name}",
    },
    {
      "type": "gpu",
      "format": "{vendor} {name}",
    },
    "memory",
    "swap",
    "disk",
    "display",
    "break",
    {
      "type": "custom",
      "format": "├{$1} System Information {$1}──┤",
    },
    "break",
    "os",
    "kernel",
    "uptime",
    // "localip",
    "break",
    {
      "type": "custom",
      "format": "├{$1} Software Information {$1}┤",
    },
    "break",
    "wm",
    "shell",
    "terminal",
    {
      "type": "font",
      "key": "System Font"
    },
    {
      "type": "command",
      "key": "Terminal Font",
      "keyIcon": "",
      "text": "cat ~/.config/kitty/kitty.conf ~/.config/alacritty/alacritty.toml 2>/dev/null | grep -E '^(font_family|family)' | head -n 1 | sed 's/^.*family[^a-zA-Z0-9]*//' | tr -d '\\\"'"
    },
    "packages",
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────┘",
    },
    "colors",
  ],
}
